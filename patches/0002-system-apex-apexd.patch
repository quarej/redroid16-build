+// Prototype of the Android 13 flattened APEX path, adapted to the Android 16
+// partition map and generated ApexInfo metadata. Requires actual boot testing.
+int ActivateFlattenedApex() {
+  std::vector<com::android::apex::ApexInfo> infos;
+
+  for (const auto& [partition, dir] : gConfig->builtin_dirs) {
+    if (access(dir.c_str(), F_OK) != 0 && errno == ENOENT) continue;
+    auto directories = ReadDir(dir, [](const auto& entry) {
+      std::error_code ec;
+      return entry.is_directory(ec);
+    });
+    if (!directories.ok()) {
+      LOG(ERROR) << "Cannot scan flattened APEX directory " << dir << ": "
+                 << directories.error();
+      return 1;
+    }
+    std::sort(directories->begin(), directories->end());
+    for (const auto& apex_dir : *directories) {
+      auto manifest = ReadManifest(apex_dir + "/" + kManifestFilenamePb);
+      if (!manifest.ok()) {
+        LOG(WARNING) << "Skipping directory without an APEX manifest: " << apex_dir;
+        continue;
+      }
+      std::string mount_point = std::string(kApexRoot) + "/" + manifest->name();
+      if (mkdir(mount_point.c_str(), 0755) != 0 && errno != EEXIST) {
+        PLOG(ERROR) << "Cannot create APEX mount point " << mount_point;
+        return 1;
+      }
+      if (mount(apex_dir.c_str(), mount_point.c_str(), nullptr, MS_BIND, nullptr) != 0) {
+        PLOG(ERROR) << "Cannot bind mount " << apex_dir << " at " << mount_point;
+        return 1;
+      }
+      infos.emplace_back(manifest->name(), apex_dir,
+                         std::optional<std::string>(apex_dir), manifest->version(),
+                         manifest->versionname(), true, true,
+                         std::optional<int64_t>(0),
+                         manifest->providesharedapexlibs(), CastPartition(partition));
+    }
+  }
+  if (infos.empty()) {
+    LOG(ERROR) << "No flattened APEX packages found";
+    return 1;
+  }
+  std::ostringstream xml;
+  com::android::apex::ApexInfoList apex_info_list(infos);
+  com::android::apex::write(xml, apex_info_list);
+  unique_fd fd(TEMP_FAILURE_RETRY(
+      open(kApexInfoList, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644)));
+  if (fd.get() == -1 || !android::base::WriteStringToFd(xml.str(), fd)) {
+    PLOG(ERROR) << "Cannot write flattened apex-info-list.xml";
+    return 1;
+  }
+  fd.reset();
+  if (auto status = RestoreconPath(kApexInfoList); !status.ok()) {
+    LOG(ERROR) << "Cannot restorecon flattened apex-info-list.xml: " << status.error();
+    return 1;
+  }
+  return 0;
+}
